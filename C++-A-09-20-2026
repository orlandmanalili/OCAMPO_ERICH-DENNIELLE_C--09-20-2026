//Operator and expressions
#include <iostream>
using namespace std;

int main() {
    int a = 10, b=3;

    //--------Arithmetic operators-------
    cout << "a + b = " << (a + b) << endl; // addition
    cout << "a - b = " << (a - b) << endl; // subtraction
    cout << "a * b = " << (a * b) << endl; // multiplication
    cout << "a / b = " << (a / b) << endl; // integer division -> 3 (drops decimal!)
    cout << "a % b = " << (a % b) << endl; // modulus -> remainder = 1

    double x = 10, y = 3;
    count << "x / y = " << (x / y) << endl; // 3,333333 -> floating point division

    //-------Relational operators (return bool: 1 or 0)------
    cout << "\na == b: " << (a == b) << endl; 
    cout << "a != b: " << (a != b) << endl;
    cout << "a > b: " << (a > b) << endl; 
    cout << "a < b: " << (a < b) << endl; 

    //-------Logical operators-------
    bool p = true, q = false;
    cout << "\np && q: " << (p && q) << endl; // AND -> false 
    cout << "p || q: " << (p || q) << endl; // OR -> true
    cout << "!p: "     << (p!)    << endl; // NOT -> false 

    //------Assignment operators -------
    int score = 50;
    score += 10; // same as score = score + 10
    cout << "\nscore after += 10: " << score << endl; 
    score *= 2; // same as score = score * 2
    cout << "score after *= 2: " << score << endl;  

    //--------Increment / decrement---------
    int counter = 5;
    cout << "\ncounter++ (post): " << counter++ << endl; // prints 5, THEN increments
    cout << "counter now: " << counter << endl; // now 6
    cout << "++counter (pre): " << ++counter << endl; // increments THEN prints -> 7

    return 0;
}

